{
  "name": "@velco/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.13.1"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/main.ts",
    "dev": "node --experimental-strip-types src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run test/fundacion/postgres-container.test.ts",
    "db:seed": "node --experimental-strip-types prisma/seed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/swagger": "9.9.5",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@velco/domain": "0.1.0",
    "exceljs": "4.4.0",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.2",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "prisma": "7.10.1",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
