datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Configuracion {
  id                     Int     @id @default(1)
  valorHoraEstandar      Decimal @default(0) @db.Decimal(12, 2) @map("valor_hora_estandar")
  diasAlertaRiesgo       Int     @default(3) @map("dias_alerta_riesgo")
  porcentajeAvanceRiesgo Int     @default(80) @map("porcentaje_avance_riesgo")
  etapasDefault          Json    @default("[\"Corte\",\"Soldadura\",\"Mecanizado\",\"Pintura\",\"Entrega\"]") @map("etapas_default")

  @@map("configuracion")
}

model Cliente {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre    String         @unique @db.VarChar(150)
  createdAt DateTime       @default(now()) @db.Timestamptz(6) @map("created_at")
  ordenes   OrdenTrabajo[]

  @@map("clientes")
}

enum TipoMaterial {
  MP
  INSUMOS
  TERCERIZADOS
}

model OrdenTrabajo {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  numeroOp         String          @unique @db.VarChar(50) @map("numero_op")
  codigoPlano      String?         @db.VarChar(80) @map("codigo_plano")
  clienteId        String          @db.Uuid @map("cliente_id")
  cliente          Cliente         @relation(fields: [clienteId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "ordenes_trabajo_cliente_id_fkey")
  descripcionPieza String          @map("descripcion_pieza")
  fechaIngreso     DateTime        @default(dbgenerated("CURRENT_DATE")) @db.Date @map("fecha_ingreso")
  fechaEntrega     DateTime        @db.Date @map("fecha_entrega")
  montoVendido     Decimal         @default(0) @db.Decimal(14, 2) @map("monto_vendido")
  observaciones    String?
  createdAt        DateTime        @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt        DateTime        @default(now()) @db.Timestamptz(6) @map("updated_at")
  etapas           EtapaOrden[]
  materiales       MaterialOrden[]
  registrosHoras   RegistroHora[]

  @@index([clienteId], map: "ordenes_trabajo_cliente_id_idx")
  @@index([fechaEntrega], map: "ordenes_trabajo_fecha_entrega_idx")
  @@map("ordenes_trabajo")
}

model MaterialOrden {
  id                    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ordenId               String       @db.Uuid @map("orden_id")
  orden                 OrdenTrabajo @relation(fields: [ordenId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "materiales_orden_orden_id_fkey")
  tipo                  TipoMaterial
  descripcion           String
  cantidad              Decimal      @db.Decimal(12, 4)
  unidad                String?      @db.VarChar(20)
  costoUnitarioCotizado Decimal      @db.Decimal(14, 2) @map("costo_unitario_cotizado")
  costoUnitarioReal     Decimal?     @db.Decimal(14, 2) @map("costo_unitario_real")
  nroRemito             String?      @db.VarChar(50) @map("nro_remito")
  nroFactura            String?      @db.VarChar(50) @map("nro_factura")
  nt                    String?      @db.VarChar(50)
  po                    String?      @db.VarChar(50)

  @@index([ordenId, tipo], map: "materiales_orden_orden_id_tipo_idx")
  @@index([nroFactura], map: "materiales_orden_nro_factura_idx")
  @@index([nt], map: "materiales_orden_nt_idx")
  @@index([po], map: "materiales_orden_po_idx")
  @@map("materiales_orden")
}

model EtapaOrden {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ordenId       String          @db.Uuid @map("orden_id")
  orden         OrdenTrabajo    @relation(fields: [ordenId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "etapas_orden_orden_id_fkey")
  nombre        String          @db.VarChar(100)
  ordenSecuencia Int            @map("orden_secuencia")
  completada    Boolean         @default(false)
  horasVendidas Decimal         @default(0) @db.Decimal(8, 2) @map("horas_vendidas")
  registrosHoras RegistroHora[]

  @@unique([ordenId, ordenSecuencia], map: "etapas_orden_orden_id_orden_secuencia_key")
  @@map("etapas_orden")
}

model RegistroHora {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ordenId     String       @db.Uuid @map("orden_id")
  orden       OrdenTrabajo @relation(fields: [ordenId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "registros_horas_orden_id_fkey")
  etapaId     String?      @db.Uuid @map("etapa_id")
  etapa       EtapaOrden?  @relation(fields: [etapaId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "registros_horas_etapa_id_fkey")
  operario    String       @db.VarChar(100)
  fecha       DateTime     @default(dbgenerated("CURRENT_DATE")) @db.Date
  horas       Decimal      @db.Decimal(6, 2)
  createdAt   DateTime     @default(now()) @db.Timestamptz(6) @map("created_at")
  observacion String?      @db.Text

  @@index([ordenId, fecha], map: "registros_horas_orden_id_fecha_idx")
  @@index([etapaId], map: "registros_horas_etapa_id_idx")
  @@index([operario], map: "registros_horas_operario_idx")
  @@map("registros_horas")
}
